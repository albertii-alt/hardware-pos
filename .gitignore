# ── Database credentials ──────────────────────────────────────────────────────
# If you ever extract db config to a separate file, ignore it here
db.config.php
.env

# ── Storage: backups ──────────────────────────────────────────────────────────
# Never commit database dumps — they contain real customer/business data
storage/backups/*.sql
storage/backups/*.sql.gz

# ── Storage: logs ─────────────────────────────────────────────────────────────
storage/logs/*.log

# Keep the directory structure but not the files
!storage/backups/.gitkeep
!storage/logs/.gitkeep

# ── Storage: raw geographic JSON data ─────────────────────────────────────────
# Large source files used only for the one-time import script
storage/data/ph-json/*.json

# Keep references file (documents data source)
!storage/data/ph-json/references.txt

# ── OS & editor junk ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ── PHP ───────────────────────────────────────────────────────────────────────
*.cache

# ── Composer (not used, but safe to include) ──────────────────────────────────
vendor/
composer.lock

# ── Node (not used, but safe to include) ──────────────────────────────────────
node_modules/
package-lock.json
yarn.lock
