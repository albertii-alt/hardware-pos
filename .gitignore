# ── Database credentials ──────────────────────────────────────────────────────
config/database.php
.env

# ── Storage: backups ──────────────────────────────────────────────────────────
storage/backups/*.sql
storage/backups/*.sql.gz

# ── Storage: logs ─────────────────────────────────────────────────────────────
storage/logs/*.log

# Keep directory structure
!storage/backups/.gitkeep
!storage/logs/.gitkeep

# ── Storage: raw geographic JSON data ─────────────────────────────────────────
storage/data/ph-json/*.json
!storage/data/ph-json/references.txt

# ── OS & editor junk ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ── PHP ───────────────────────────────────────────────────────────────────────
*.cache

# ── Composer (not used, but safe to include) ──────────────────────────────────
vendor/
composer.lock

# ── Node (not used, but safe to include) ──────────────────────────────────────
node_modules/
package-lock.json
yarn.lock
